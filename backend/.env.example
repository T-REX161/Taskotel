# Taskotel backend - local settings template. Copy this file to backend/.env and fill in your own values there.
# backend/.env is git-ignored; this example holds placeholders only and must never contain real credentials.
#
# The backend reads backend/.env automatically on startup (spring.config.import in application.yml).
# Format: KEY=value, one setting per line, no quotes, no spaces around "=". Lines starting with # are comments.
# A real environment variable with the same name always wins over the value in this file.

# Cloudinary (profile pictures). Use the values from the Cloudinary console.
# Until all three are filled in, the backend still starts and profile picture uploads are unavailable.
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# SendGrid (verification, OTP and password-reset emails). Without SENDGRID_API_KEY the backend starts, but every email fails and an account
# that has not verified its email cannot sign in (the code that verifies it cannot be sent).
# SENDGRID_FROM_EMAIL has no default: it must be exactly the Single Sender / authenticated-domain address verified in your SendGrid account.
# The API key needs at least the "Mail Send" permission.
SENDGRID_API_KEY=your_sendgrid_api_key
SENDGRID_FROM_EMAIL=your_verified_sender_email
SENDGRID_FROM_NAME=Taskotel
